# ============================================================
# OscarZone — Environment Variables
# ============================================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ──────────────────────────────────────────────────────────
# SUPABASE (Frontend — safe to expose)
# ──────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ──────────────────────────────────────────────────────────
# SUPABASE SERVICE ROLE (Edge Functions only — NEVER expose)
# Set via: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=xxx
# ──────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────
# CLOUDFLARE R2 (Edge Functions only — NEVER expose to browser)
# Set via: supabase secrets set R2_ACCESS_KEY_ID=xxx
# ──────────────────────────────────────────────────────────
# R2_ACCOUNT_ID=ffeea7891345dc256a5d6a7b9a0f1e40
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=oscar-zone-screenshots
# R2_ENDPOINT=https://ffeea7891345dc256a5d6a7b9a0f1e40.r2.cloudflarestorage.com

# ──────────────────────────────────────────────────────────
# TELEGRAM BOT (Edge Functions only — NEVER expose to browser)
# Set via: supabase secrets set TELEGRAM_BOT_TOKEN=xxx
# ──────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
