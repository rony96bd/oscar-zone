# =============================================================================
# REQUIRED: Supabase Credentials
# =============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# REQUIRED: App Branding (used in PWA manifest, meta tags, fallback text)
# =============================================================================
VITE_APP_NAME=GameZone
VITE_APP_SHORT_NAME=GameZone
VITE_APP_TAGLINE=Top Up. Play More. Win Big.
VITE_APP_DESCRIPTION=The #1 trusted game loading service.
VITE_APP_URL=https://yourdomain.com

# =============================================================================
# OPTIONAL: Default Support Contact (also configurable from Admin Settings)
# =============================================================================
VITE_DEFAULT_SUPPORT_EMAIL=support@yourdomain.com
VITE_DEFAULT_SUPPORT_TELEGRAM=https://t.me/yourchannel
VITE_DEFAULT_SUPPORT_FACEBOOK=https://facebook.com/yourpage
